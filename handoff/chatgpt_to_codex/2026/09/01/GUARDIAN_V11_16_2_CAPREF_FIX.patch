+// v11.16.2 CAPREF FIX: le grade A+/A/B/C reste un diagnostic/priorisateur pour Momentum.
+// Il ne doit plus reduire le risque d'un signal Momentum valide sous le plancher 0,25 %.
+// Les reductions de securite renvoyees par GetEffectiveRiskPercent() (drawdown / stop trading)
+// restent intactes et conservent la priorite.
+double ExecutionRiskFactorForEngine(const string engine_name,const double ranked_factor)
+  {
+   if(StringFind(engine_name,"Momentum")>=0) return 1.0;
+   return ranked_factor;
+  }
+
+bool MomentumRiskPolicySelfTest()
+  {
+   const double eps=0.0000001;
+   bool ok=(MathAbs(ExecutionRiskFactorForEngine("Momentum BUY",1.00)-1.0)<=eps &&
+            MathAbs(ExecutionRiskFactorForEngine("Momentum BUY",0.75)-1.0)<=eps &&
+            MathAbs(ExecutionRiskFactorForEngine("Momentum BUY",0.50)-1.0)<=eps &&
+            MathAbs(ExecutionRiskFactorForEngine("Momentum BUY",0.25)-1.0)<=eps &&
+            MathAbs(ExecutionRiskFactorForEngine("Momentum SELL",0.25)-1.0)<=eps);
+   PrintFormat("MOMENTUM_RISK_POLICY_SELFTEST %s | grade scaling diagnostic only | exec factor=1.00",ok?"PASS":"FAIL");
+   return ok;
+  }
+
+double RiskFloorSizingToleranceUSD(const string symbol,const double sl_points,const ENUM_ORDER_TYPE order_type)
+  {
+   // Le lot est toujours arrondi vers le bas pour ne jamais depasser le budget risque.
+   // On tolere donc au maximum l'ecart correspondant a UN pas de volume broker.
+   // Une reduction plus forte (marge/max lot/etc.) reste bloquee par le plancher.
+   double step_lot=SymbolInfoDouble(symbol,SYMBOL_VOLUME_STEP);
+   if(step_lot<=0.0) return 0.01;
+   double step_risk=0.0;
+   if(!CalculateLossAtLot(symbol,sl_points,order_type,step_lot,step_risk) || step_risk<=0.0) return 0.01;
+   return step_risk+0.01;
+  }
